# Terraform plugin cache and provider binaries
.terraform/
.terraform.lock.hcl

# State files (contain sensitive infrastructure details)
terraform.tfstate
terraform.tfstate.backup

# Saved plan files
*.tfplan
tfplan

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
